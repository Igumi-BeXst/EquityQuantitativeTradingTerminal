/* StockTerminal light theme */
QMainWindow, QDialog {
    background-color: #f5f5f5;
}
QMenuBar {
    background-color: #ffffff;
    color: #222222;
}
QMenuBar::item:selected {
    background-color: #e3edf9;
}
QMenu {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #d0d0d0;
}
QMenu::item:selected {
    background-color: #e3edf9;
    color: #0b3d91;
}
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d0d0d0;
    spacing: 4px;
    padding: 2px;
}
QStatusBar {
    background-color: #ffffff;
    color: #666666;
    border-top: 1px solid #d0d0d0;
}
QDockWidget {
    color: #222222;
}
QDockWidget::title {
    background-color: #eaeaea;
    padding: 4px;
    border-bottom: 1px solid #d0d0d0;
}
QPlainTextEdit, QLineEdit, QComboBox, QListWidget, QTableWidget {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #c8c8c8;
}
QLineEdit:focus, QComboBox:focus {
    border-color: #4a7dbb;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #222222;
    selection-background-color: #e3edf9;
    selection-color: #0b3d91;
}
QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #e3edf9;
    color: #0b3d91;
}
QPushButton {
    background-color: #f0f0f0;
    color: #222222;
    border: 1px solid #b8b8b8;
    padding: 4px 12px;
    border-radius: 3px;
}
QPushButton:hover {
    background-color: #e6e6e6;
}
QPushButton:pressed {
    background-color: #d9d9d9;
}
QCheckBox {
    color: #222222;
    spacing: 5px;
}
QLabel {
    color: #222222;
    background: transparent;
}
QScrollBar:vertical {
    background: #f0f0f0;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #b8b8b8;
    min-height: 30px;
    border-radius: 6px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QToolTip {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #b8b8b8;
}
