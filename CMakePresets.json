{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (MSVC + Ninja + vcpkg, Qt OFF)",
      "description": "Debug build with MSVC + vcpkg. Qt separate via CMAKE_PREFIX_PATH.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "BUILD_WITH_QT": "OFF"
      }
    },
    {
      "name": "with-qt",
      "displayName": "With Qt (MSVC + Ninja + vcpkg)",
      "description": "Debug build with Qt UI enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.11.1/msvc2022_64",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "BUILD_WITH_QT": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (MSVC + Ninja + vcpkg)",
      "description": "Release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "BUILD_WITH_QT": "OFF"
      }
    },
    {
      "name": "release-qt",
      "displayName": "Release with Qt (MSVC + Ninja + vcpkg)",
      "description": "Release build with Qt UI enabled (日常使用版：比 Debug 快 10~50 倍)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-qt",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "VCPKG_MANIFEST_INSTALL": "OFF",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.11.1/msvc2022_64",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "BUILD_WITH_QT": "ON",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "with-qt", "configurePreset": "with-qt" },
    { "name": "release", "configurePreset": "release" },
    { "name": "release-qt", "configurePreset": "release-qt" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    }
  ]
}
